<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/search_background"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cityName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="London"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/wn_text_primary" />

        <TextView
            android:id="@+id/cityRegion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="City of London, Greater London 🇬🇧 UK"
            android:textSize="14sp"
            android:textColor="@color/wn_text_secondary"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/cityWeather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sunny 22°C"
            android:textSize="15sp"
            android:textColor="@color/wn_primary"
            android:layout_marginTop="10dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/cityWeatherIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="☀️"
        android:textSize="28sp"
        android:contentDescription="Weather condition icon" />

</LinearLayout>
