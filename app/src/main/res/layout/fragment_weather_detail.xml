<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wn_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Detail screen header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Go back"
                android:clickable="true"
                android:focusable="true"
                android:scaleType="centerInside" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/detailCityName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Toronto"
                    android:textColor="@color/wn_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/detailCityRegion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ontario, Canada"
                    android:textColor="@color/wn_text_secondary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/bookmarkButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_bookmark_outline"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Save city"
                android:scaleType="centerInside" />

        </LinearLayout>

        <!-- Weather condition -->
        <TextView
            android:id="@+id/detailCondition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Partly Cloudy"
            android:textColor="@color/wn_text_secondary"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginTop="28dp" />

        <ImageView
            android:id="@+id/detailWeatherIcon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_weather_condition"
            android:contentDescription="Weather condition icon"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp" />

        <!-- Temperature -->
        <TextView
            android:id="@+id/detailTemperatureC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="22°C"
            android:textColor="@color/wn_text_primary"
            android:textSize="56sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/detailTemperatureF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="71.6°F"
            android:textColor="@color/wn_text_secondary"
            android:textSize="20sp"
            android:gravity="center"
            android:layout_marginTop="4dp" />

        <!-- Weather details heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Weather Details"
            android:textColor="@color/wn_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp" />

        <!-- Weather details card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/wn_surface"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Humidity"
                    android:textColor="@color/wn_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/detailHumidity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="65%"
                    android:textColor="@color/wn_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wind"
                    android:textColor="@color/wn_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/detailWind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12 km/h"
                    android:textColor="@color/wn_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Feels Like"
                    android:textColor="@color/wn_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/detailFeelsLike"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24°C"
                    android:textColor="@color/wn_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
