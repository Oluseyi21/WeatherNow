<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/wn_navy"
    android:padding="24dp">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_weather_logo"
        android:contentDescription="WeatherNow logo"
        android:background="@color/wn_primary"
        android:padding="18dp"
        android:scaleType="fitCenter" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WeatherNow"
        android:textColor="@color/wn_surface"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginTop="18dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your personal city weather"
        android:textColor="@color/wn_splash_tagline"
        android:textSize="14sp"
        android:layout_marginTop="8dp" />

</LinearLayout>
